# ===== Telegram =====
# @BotFather'dan olingan token
BOT_TOKEN=
# Ega(lar)ning Telegram ID'lari, vergul bilan (har doim admin, o'chirib bo'lmaydi)
OWNER_IDS=
# Web App ochiladigan to'liq HTTPS manzil (Replit deploy manzili), oxirida "/" siz
WEBAPP_URL=https://footballcenter.example.repl.co
# true — webhook (Replit Deployments uchun tavsiya), false — long polling
USE_WEBHOOK=false
# Webhook so'rovlarini tekshirish uchun ixtiyoriy maxfiy satr (A-Z, a-z, 0-9, _ va -)
WEBHOOK_SECRET=

# ===== Ma'lumotlar bazasi (PostgreSQL) =====
DATABASE_URL=postgres://user:password@host:5432/footballcenter
# Neon/Supabase kabi tashqi bazalar uchun true
DATABASE_SSL=true

# ===== Web admin paneli (brauzerdan kirish uchun) =====
ADMIN_LOGIN=
ADMIN_PASSWORD=
# Sessiya imzosi uchun uzun tasodifiy satr
SESSION_SECRET=

# ===== Tashqi API'lar =====
# football-data.org kaliti — keyinroq qo'shiladi; bo'sh bo'lsa futbol bo'limlari "mavjud emas" deydi
FOOTBALL_API_KEY=
# 🤖 AI Yordamchi (Claude API) kaliti; bo'sh bo'lsa AI "hozircha ishlamayapti" deydi
ANTHROPIC_API_KEY=
# Quiz savollari manbasi (standart: Open Trivia DB, Sport toifasi)
# QUIZ_API_URL=https://opentdb.com/api.php?amount=50&category=21&type=multiple

PORT=3000
