# ===== Telegram =====
# @BotFather'dan olingan token
BOT_TOKEN=
# Ega(lar)ning Telegram ID'lari, vergul bilan (har doim admin, o'chirib bo'lmaydi)
OWNER_IDS=
# Web App ochiladigan to'liq HTTPS manzil, oxirida "/" siz (Telegram faqat HTTPS qabul qiladi)
WEBAPP_URL=https://football.example.com
# false — long polling (oddiy, hech narsa sozlash shart emas), true — webhook (WEBAPP_URL/tg-webhook)
USE_WEBHOOK=false
# Webhook so'rovlarini tekshirish uchun ixtiyoriy maxfiy satr (A-Z, a-z, 0-9, _ va -)
WEBHOOK_SECRET=

# ===== Docker Compose =====
# Baza paroli (compose ichidagi PostgreSQL uchun; DATABASE_URL avtomatik tuziladi)
POSTGRES_PASSWORD=
# --profile https uchun domen (DNS shu serverga yo'naltirilgan bo'lishi kerak)
DOMAIN=football.example.com
# Ilova porti (host'da)
APP_PORT=3000

# ===== Docker'siz ishga tushirilsa — o'zingizning PostgreSQL =====
DATABASE_URL=postgres://user:password@localhost:5432/footballcenter
# Tashqi (bulutli) bazalar uchun true
DATABASE_SSL=false

# ===== Web admin paneli (brauzerdan kirish uchun) =====
ADMIN_LOGIN=
ADMIN_PASSWORD=
# Sessiya imzosi uchun uzun tasodifiy satr
SESSION_SECRET=

# ===== Tashqi API'lar =====
# football-data.org kaliti; bo'sh bo'lsa futbol bo'limlari "mavjud emas" deydi
FOOTBALL_API_KEY=
# 🤖 AI Yordamchi (Claude API) kaliti; bo'sh bo'lsa AI "hozircha ishlamayapti" deydi
ANTHROPIC_API_KEY=
# Quiz savollari manbasi (standart: Open Trivia DB, Sport toifasi)
# QUIZ_API_URL=https://opentdb.com/api.php?amount=50&category=21&type=multiple

PORT=3000
