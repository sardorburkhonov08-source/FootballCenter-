# FootballCenter — environment variable'lar ro'yxati.
# Bu faylga HAQIQIY QIYMAT YOZMANG (repo public). Railway'da: servis → Variables.
# Lokal ishlab chiqish uchun nusxa oling: cp .env.example .env  (.env git'ga tushmaydi)

# --- Majburiy ---
# @BotFather bergan bot tokeni
BOT_TOKEN=
# Railway PostgreSQL ulanish manzili (Railway'da: ${{Postgres.DATABASE_URL}})
DATABASE_URL=
# Admin/ega Telegram ID'lari, vergul bilan (masalan: 111111111,222222222)
ADMIN_IDS=
# Serverning ommaviy HTTPS manzili, oxirida "/" siz (Railway → Settings → Networking → Generate Domain)
# Bot webhook'i shu manzil + /telegram/webhook ga, Mini App shu manzil + /app ga o'rnatiladi.
# Lokal ishlab chiqishda bo'sh qoldiring — bot long polling rejimida ishlaydi.
WEBHOOK_URL=

# --- Ixtiyoriy ---
# API-Football (api-sports.io) kaliti (bo'sh bo'lsa futbol bo'limlari "mavjud emas" deydi)
FOOTBALL_API_KEY=
# 🤖 AI Yordamchi uchun Claude API kaliti (bo'sh bo'lsa AI "hozircha ishlamayapti" deydi)
ANTHROPIC_API_KEY=
# Web admin paneliga brauzerdan kirish (bo'sh bo'lsa faqat Telegram orqali admin kiradi)
ADMIN_LOGIN=
ADMIN_PASSWORD=
# Yuklangan fayllar papkasi (Railway Volume ulangan bo'lsa avtomatik aniqlanadi)
UPLOAD_DIR=
# Tashqi PostgreSQL SSL talab qilsa: true (Railway ichki tarmog'ida kerak emas)
DATABASE_SSL=
# Lokal port (Railway o'zi beradi)
PORT=
